---
/**
 * Layout base único para el sitio (una sola página).
 * Estructura de documento + metadata; sin maquetación de secciones
 * de UI — esas se componen en src/pages/index.astro a partir de
 * Fase 2 (ver PROJECT_STATE.md).
 */
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Bloqueante a propósito: resuelve el tema antes del primer pintado
      // para evitar el parpadeo de tema incorrecto (FOUC). Duplica una
      // pequeña porción de la lógica de ThemeToggle.astro porque debe
      // ejecutarse de forma síncrona, sin esperar a ningún módulo.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var isDark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.add(isDark ? 'dark' : 'light');
        } catch (error) {
          // localStorage/matchMedia inaccesibles — se conserva el tema
          // claro por defecto en vez de romper la carga de la página.
        }
      })();
    </script>
    <script is:inline>
      // Bloqueante a propósito: quita "no-js" antes del primer pintado.
      // global.css oculta los elementos [data-hero-anim] solo bajo
      // html:not(.no-js) — así, sin JS (o si este script falla), el
      // contenido del Hero queda visible por defecto (fallback de
      // accesibilidad) en vez de depender de que la animación corra.
      document.documentElement.classList.remove('no-js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph — completar con imagen dedicada en Fase 5 -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <!--
      Fondo ambiental — luces difusas fijas y estáticas (sin JS, sin GSAP)
      que le dan profundidad a la página. Vive fuera de #smooth-content por
      la misma razón que el Header: al ser position:fixed y hermano del
      wrapper (no su descendiente), no lo afecta el transform que
      ScrollSmoother aplica a #smooth-content, y se mantiene fijo respecto
      al viewport mientras el usuario hace scroll. -z-10 lo deja siempre
      detrás del Header/MenuMovil (z-50/z-40) y del contenido normal;
      pointer-events-none y aria-hidden porque es puramente decorativo — no
      debe interceptar clics ni aparecer en el árbol de accesibilidad. Los
      colores vienen de --primary/--accent (ya definidos para claro/oscuro
      en global.css), así que se adaptan solos entre temas sin duplicar
      valores aquí.
    -->
    <div id="fondo-ambiental" aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="bg-primary/10 dark:bg-primary/45 absolute -top-32 -left-24 h-96 w-96 rounded-full blur-3xl"
      >
      </div>
      <div
        class="bg-accent/10 dark:bg-accent/40 absolute top-1/4 -right-32 h-[28rem] w-[28rem] rounded-full blur-3xl"
      >
      </div>
      <div
        class="bg-accent/5 dark:bg-primary/35 absolute bottom-0 left-1/3 h-80 w-80 rounded-full blur-3xl"
      >
      </div>
    </div>

    <!--
      El Header (slot "fixed") vive fuera de #smooth-content a propósito:
      ScrollSmoother transforma #smooth-content para simular el scroll, y
      cualquier position: sticky/fixed DENTRO de un ancestro transformado
      deja de funcionar. Aquí, al ser hermano del wrapper y no
      descendiente, el Header sigue siendo sticky de forma nativa sin
      tratamiento adicional.
    -->
    <slot name="fixed" />

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>

    <script>
      // Punto único de inicialización de animaciones (Fase 4).
      // ScrollSmoother se inicializa primero: ScrollTrigger necesita
      // que el "scroller" ya esté configurado antes de crear los
      // triggers de las animaciones siguientes, para que disparen en
      // la posición de scroll correcta desde el primer fotograma.
      import { inicializarScrollSmoother } from '@/lib/gsap/scrollSmoother';
      import {
        inicializarContadores,
        inicializarEntradaHero,
        inicializarRevealsDeScroll,
      } from '@/lib/gsap/animations';
      inicializarScrollSmoother();
      inicializarContadores();
      inicializarEntradaHero();
      inicializarRevealsDeScroll();
    </script>
  </body>
</html>
