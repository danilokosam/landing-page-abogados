---
/**
 * Layout base único para el sitio (una sola página).
 * Estructura de documento + metadata; sin maquetación de secciones
 * de UI — esas se componen en src/pages/index.astro a partir de
 * Fase 2 (ver PROJECT_STATE.md).
 */
import '@/styles/global.css';
import IntroCarga from '@/components/static/IntroCarga.astro';
// URL con hash de la fuente de los titulares (Playfair 500, subset latin):
// se precarga para que ni la intro ni el titular del Hero (LCP) pinten
// primero con la fuente de reserva y "salten" al cambiarla.
import playfair500 from '@fontsource/playfair-display/files/playfair-display-latin-500-normal.woff2?url';

import { seo, urlAbsoluta } from '@/lib/seo';
import { negocio } from '@/lib/negocio';

interface Props {
  title: string;
  description: string;
  /** Excluye la página del índice (p. ej. la 404). */
  noindex?: boolean;
  /** Muestra la intro de carga (solo tiene sentido en la portada). */
  intro?: boolean;
}

const { title, description, noindex = false, intro = true } = Astro.props;

// URLs absolutas: WhatsApp, Facebook, LinkedIn y X ignoran rutas relativas
// en og:image/og:url. La base sale de `site` (astro.config.mjs).
const urlCanonica = urlAbsoluta(Astro.url.pathname, Astro.site);
const urlImagenOg = urlAbsoluta(seo.og.imagen, Astro.site);
---

<!doctype html>
<html lang={seo.idioma} class="no-js" data-sin-intro={intro ? undefined : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={urlCanonica} />}
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={negocio.nombreDespacho} />
    <meta name="format-detection" content="telephone=no" />

    <!--
      Tarjeta al compartir el enlace (WhatsApp, Facebook, LinkedIn, X...).
      Imagen 1200×630 en JPEG (<300 KB, límite práctico de WhatsApp),
      generada con `npm run assets:seo` (scripts/generar-assets-seo.mjs).
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={negocio.nombreDespacho} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:title" content={seo.og.titulo} />
    <meta property="og:description" content={seo.og.descripcion} />
    <meta property="og:image" content={urlImagenOg} />
    <meta property="og:image:secure_url" content={urlImagenOg} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(seo.og.imagenAncho)} />
    <meta property="og:image:height" content={String(seo.og.imagenAlto)} />
    <meta property="og:image:alt" content={seo.og.imagenAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.og.titulo} />
    <meta name="twitter:description" content={seo.og.descripcion} />
    <meta name="twitter:image" content={urlImagenOg} />
    <meta name="twitter:image:alt" content={seo.og.imagenAlt} />

    <!-- Iconos y apariencia del navegador / pantalla de inicio -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e13" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href={playfair500} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // Bloqueante a propósito: resuelve el tema antes del primer pintado
      // para evitar el parpadeo de tema incorrecto (FOUC). Duplica una
      // pequeña porción de la lógica de ThemeToggle.astro porque debe
      // ejecutarse de forma síncrona, sin esperar a ningún módulo.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var isDark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.add(isDark ? 'dark' : 'light');
        } catch (error) {
          // localStorage/matchMedia inaccesibles — se conserva el tema
          // claro por defecto en vez de romper la carga de la página.
        }
      })();
    </script>
    <script is:inline>
      // Bloqueante a propósito: quita "no-js" antes del primer pintado.
      // global.css oculta los elementos [data-reveal] solo bajo
      // html:not(.no-js) — así, sin JS (o si este script falla), el
      // contenido queda visible por defecto en vez de depender de GSAP.
      document.documentElement.classList.remove('no-js');
    </script>
    <script is:inline>
      // Intro de carga (IntroCarga.astro). Bloqueante a propósito: la clase
      // debe estar en <html> antes del primer pintado para que el telón
      // aparezca desde el fotograma 0, sin destello del contenido debajo.
      // Solo se muestra:
      //   - una vez por sesión (no castiga a quien recarga o vuelve),
      //   - sin prefers-reduced-motion,
      //   - fuera de navegadores automatizados (navigator.webdriver: tests
      //     e2e de Playwright, que interactúan con la página al instante).
      // Clic o Escape la saltan. Se retira sola a los 3 s. Las páginas que
      // no la quieren (404) marcan <html data-sin-intro> con la prop `intro`.
      (function () {
        try {
          var d = document.documentElement;
          if (
            navigator.webdriver ||
            d.hasAttribute('data-sin-intro') ||
            sessionStorage.getItem('intro-vista') ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
          )
            return;
          sessionStorage.setItem('intro-vista', '1');
          d.classList.add('intro', 'intro-activa');

          var terminada = false;
          function terminar(saltada) {
            if (terminada) return;
            terminada = true;
            clearTimeout(temporizador);
            document.removeEventListener('click', alClic, true);
            document.removeEventListener('keydown', alTeclear);
            // Si se saltó, se quita también el retraso del Hero para que su
            // entrada no se quede esperando a una intro que ya no está.
            if (saltada) d.classList.remove('intro');
            d.classList.remove('intro-activa');
            var el = document.getElementById('intro');
            if (el) el.remove();
          }
          function alClic(e) {
            if (e.target instanceof Element && e.target.closest('#intro')) terminar(true);
          }
          function alTeclear(e) {
            if (e.key === 'Escape') terminar(true);
          }
          var temporizador = setTimeout(function () {
            terminar(false);
          }, 3000);
          document.addEventListener('click', alClic, true);
          document.addEventListener('keydown', alTeclear);
        } catch (error) {
          // sessionStorage/matchMedia inaccesibles: sin intro, nunca bloquea.
        }
      })();
    </script>

    <!-- Contenido extra del <head> por página (p. ej. JSON-LD) -->
    <slot name="head" />
  </head>
  <body>
    {intro && <IntroCarga />}

    <!--
      Fondo ambiental — luces difusas fijas y estáticas (sin JS). Los
      degradados viven en global.css (#fondo-ambiental) como
      radial-gradient: mismo efecto que los antiguos bloques con blur, sin
      el coste de un filtro de desenfoque. Vive fuera de #smooth-content
      para no recibir el transform de ScrollSmoother; -z-10 lo deja detrás
      de todo y pointer-events-none/aria-hidden porque es decorativo.
    -->
    <div id="fondo-ambiental" aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
    </div>

    <!--
      El Header (slot "fixed") vive fuera de #smooth-content a propósito:
      ScrollSmoother transforma #smooth-content para simular el scroll, y
      cualquier position: sticky/fixed DENTRO de un ancestro transformado
      deja de funcionar. Aquí, al ser hermano del wrapper y no
      descendiente, el Header sigue siendo sticky de forma nativa sin
      tratamiento adicional.
    -->
    <slot name="fixed" />

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>

    <script>
      // Punto único de inicialización de animaciones (Fase 4).
      // ScrollSmoother se inicializa primero: ScrollTrigger necesita
      // que el "scroller" ya esté configurado antes de crear los
      // triggers de las animaciones siguientes, para que disparen en
      // la posición de scroll correcta desde el primer fotograma.
      import { inicializarScrollSmoother } from '@/lib/gsap/scrollSmoother';
      // La entrada del Hero ya no pasa por aquí: es CSS puro (global.css)
      // para que el titular no espere a la descarga de este bundle.
      import { inicializarContadores, inicializarRevealsDeScroll } from '@/lib/gsap/animations';
      inicializarScrollSmoother();
      inicializarContadores();
      inicializarRevealsDeScroll();
    </script>
  </body>
</html>
