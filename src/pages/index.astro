---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/static/Header.astro';
import Hero from '@/components/static/Hero.astro';
import CifrasClave from '@/components/static/CifrasClave.astro';
import SobreNosotros from '@/components/static/SobreNosotros.astro';
import Servicios from '@/components/static/Servicios.astro';
import Footer from '@/components/static/Footer.astro';
import { negocio } from '@/lib/negocio';
---

<BaseLayout
  title={`${negocio.nombreDespacho} — Abogados en ${negocio.direccion.ciudad}`}
  description={negocio.descripcionCorta}
>
  <Header slot="fixed" />
  <main>
    <Hero />
    <CifrasClave />
    <SobreNosotros />
    <Servicios />
  </main>
  <Footer />
</BaseLayout>
