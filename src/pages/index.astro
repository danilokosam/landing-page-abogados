---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/static/Header.astro';
import Hero from '@/components/static/Hero.astro';
import CifrasClave from '@/components/static/CifrasClave.astro';
import SobreNosotros from '@/components/static/SobreNosotros.astro';
import Servicios from '@/components/static/Servicios.astro';
import Footer from '@/components/static/Footer.astro';
import { seo, urlAbsoluta } from '@/lib/seo';
import { generarGrafoSchema, serializarJsonLd } from '@/lib/schema';

const socios = (await getCollection('socios')).sort((a, b) => a.data.orden - b.data.orden);
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);

const jsonLd = serializarJsonLd(
  generarGrafoSchema({
    urlSitio: urlAbsoluta('/', Astro.site),
    urlImagen: urlAbsoluta(seo.og.imagen, Astro.site),
    socios,
    servicios,
  }),
);
---

<BaseLayout title={seo.titulo} description={seo.descripcion}>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd} />
  <Header slot="fixed" />
  <main>
    <Hero />
    <CifrasClave />
    <SobreNosotros />
    <Servicios />
  </main>
  <Footer />
</BaseLayout>
