---
/**
 * Página 404 con la identidad del sitio: noindex (no debe aparecer en
 * buscadores) y sin intro de carga. Ofrece las dos salidas útiles —volver
 * al inicio o escribir por WhatsApp— para no perder la visita.
 */
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { negocio } from '@/lib/negocio';
import { construirEnlaceWhatsApp } from '@/lib/whatsapp';

const enlaceWhatsApp = construirEnlaceWhatsApp('Hola, quisiera agendar una consulta.');
---

<BaseLayout
  title={`Página no encontrada | ${negocio.nombreDespacho}`}
  description="La página que busca no existe o ha cambiado de dirección."
  noindex
  intro={false}
>
  <main class="grid min-h-dvh place-items-center px-5 py-24 text-center">
    <div class="max-w-xl">
      <p class="eyebrow">Error 404</p>
      <h1
        class="text-foreground mt-6 font-serif text-4xl leading-tight font-medium text-balance sm:text-5xl"
      >
        Esta página no existe
      </h1>
      <p class="text-muted-foreground mt-5 text-base leading-relaxed sm:text-lg">
        Es posible que el enlace esté mal escrito o que la página haya cambiado de dirección.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="bg-primary text-primary-foreground focus-visible:outline-ring inline-flex items-center justify-center gap-2 rounded-full px-7 py-4 text-[0.9375rem] font-semibold tracking-wide transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <Icon name="lucide:arrow-left" class="h-4 w-4" aria-hidden="true" />
          Volver al inicio
        </a>
        <a
          href={enlaceWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground border-border hover:border-foreground/40 focus-visible:outline-ring inline-flex items-center justify-center gap-2 rounded-full border px-7 py-4 text-[0.9375rem] font-semibold tracking-wide transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
