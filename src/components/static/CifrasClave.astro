---
/**
 * Banda de cifras clave — puramente estática en su propio marcado
 * (sin <script> propio); los atributos data-counter/data-suffix son
 * consumidos por inicializarContadores() (src/lib/gsap/animations.ts),
 * inicializada una sola vez desde BaseLayout.astro. El texto ya
 * renderiza el valor final, así que sin JS (o con
 * prefers-reduced-motion) la cifra se ve completa igualmente.
 */
interface CifraClave {
  valor: number;
  sufijo: string;
  etiqueta: string;
}

const cifras: CifraClave[] = [
  { valor: 2, sufijo: '', etiqueta: 'Socios fundadores, dedicación directa en cada caso' },
  { valor: 20, sufijo: '+', etiqueta: 'Años de experiencia combinada' },
  { valor: 6, sufijo: '', etiqueta: 'Áreas de práctica cubiertas' },
  { valor: 24, sufijo: 'h', etiqueta: 'Tiempo de respuesta habitual por WhatsApp' },
];
---

<section id="cifras-clave" class="border-border bg-muted/95 border-b">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <dl
      class="lg:divide-border grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-4 lg:gap-x-0 lg:gap-y-0 lg:divide-x"
    >
      {
        cifras.map((cifra) => (
          <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
            <dt class="text-accent font-serif text-4xl font-semibold lg:text-5xl">
              <span data-counter={cifra.valor} data-suffix={cifra.sufijo} class="tabular-nums">
                {`${cifra.valor}${cifra.sufijo}`}
              </span>
            </dt>
            <dd class="text-muted-foreground mt-2 text-sm leading-relaxed">{cifra.etiqueta}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
