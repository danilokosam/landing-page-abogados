---
/**
 * Banda de cifras clave — puramente estática en su propio marcado
 * (sin <script> propio); los atributos data-counter/data-suffix son
 * consumidos por inicializarContadores() (src/lib/gsap/animations.ts),
 * inicializada una sola vez desde BaseLayout.astro. El texto ya
 * renderiza el valor final, así que sin JS (o con
 * prefers-reduced-motion) la cifra se ve completa igualmente.
 *
 * Fondo en "tinta" (token --ink, invariante entre temas): ancla oscura
 * de marca justo después del Hero, que rompe la monotonía de bandas
 * claras y da a las cifras el peso de una credencial.
 */
interface CifraClave {
  valor: number;
  sufijo: string;
  etiqueta: string;
}

// Todas las cifras salen de las hojas de vida (src/content/socios):
//   - ejercicio: ambos se graduaron como abogados en 2017 — se calcula en
//     build time para que no se quede desactualizada con los años.
//   - INPEC: Fredy fue Inspector del 05/02/1999 al 23/09/2022 (23 años).
//   - especializaciones: Natalia 2 (Penal, Administrativo), Fredy 1.
const ANIO_GRADUACION = 2017;
const aniosEjercicio = new Date().getFullYear() - ANIO_GRADUACION;

const cifras: CifraClave[] = [
  { valor: 2, sufijo: '', etiqueta: 'Abogados, atención directa en cada caso' },
  { valor: aniosEjercicio, sufijo: '', etiqueta: 'Años de ejercicio profesional' },
  { valor: 23, sufijo: '', etiqueta: 'Años de experiencia en el sistema penitenciario (INPEC)' },
  { valor: 3, sufijo: '', etiqueta: 'Especializaciones de posgrado' },
];
---

<section id="cifras-clave" class="bg-ink text-ink-foreground relative">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-20">
    <dl
      class="lg:divide-ink-border grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-4 lg:gap-x-0 lg:divide-x"
    >
      {
        cifras.map((cifra) => (
          <div class="lg:px-10 lg:first:pl-0 lg:last:pr-0">
            <dt class="text-ink-gold font-serif text-5xl leading-none font-medium tracking-tight lg:text-6xl">
              <span data-counter={cifra.valor} data-suffix={cifra.sufijo} class="tabular-nums">
                {`${cifra.valor}${cifra.sufijo}`}
              </span>
            </dt>
            <dd class="text-ink-muted-foreground mt-4 max-w-[15rem] text-sm leading-relaxed">
              {cifra.etiqueta}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
