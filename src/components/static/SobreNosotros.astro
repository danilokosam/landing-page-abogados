---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const socios = (await getCollection('socios')).sort((a, b) => a.data.orden - b.data.orden);
const sociosConContenido = await Promise.all(
  socios.map(async (socio) => ({ socio, ...(await render(socio)) })),
);
---

<section id="sobre-nosotros" class="border-border bg-background scroll-mt-20 border-b">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl" data-reveal="left">
      <p class="text-accent text-sm font-semibold tracking-widest uppercase">Trayectoria</p>
      <h2 class="text-foreground mt-3 font-serif text-3xl font-semibold text-balance sm:text-4xl">
        Sobre nosotros
      </h2>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
        Un despacho de dos socios que combina más de dos décadas de práctica jurídica en Madrid, con
        un trato directo y personal en cada caso.
      </p>
    </div>

    <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-8" data-reveal="right">
      {
        sociosConContenido.map(({ socio, Content }) => (
          <article class="border-border bg-card flex flex-col gap-6 rounded-2xl border p-6 sm:flex-row sm:p-8">
            <Image
              src={socio.data.foto}
              alt={`Retrato de ${socio.data.nombre}`}
              width={112}
              height={112}
              class="h-28 w-28 shrink-0 rounded-full object-cover"
            />
            <div>
              <h3 class="text-foreground font-serif text-xl font-semibold">{socio.data.nombre}</h3>
              <p class="text-accent text-sm font-medium">{socio.data.cargo}</p>

              <div class="prose-p:my-3 text-muted-foreground mt-3 text-sm leading-relaxed">
                <Content />
              </div>

              <dl class="mt-5 space-y-3 text-sm">
                <div>
                  <dt class="text-foreground flex items-center gap-1.5 font-medium">
                    <Icon
                      name="lucide:graduation-cap"
                      class="text-muted-foreground h-4 w-4"
                      aria-hidden="true"
                    />
                    Formación
                  </dt>
                  <dd class="text-muted-foreground mt-1 space-y-0.5">
                    {socio.data.formacion.map((item) => (
                      <p>{item}</p>
                    ))}
                  </dd>
                </div>

                <div>
                  <dt class="text-foreground flex items-center gap-1.5 font-medium">
                    <Icon
                      name="lucide:award"
                      class="text-muted-foreground h-4 w-4"
                      aria-hidden="true"
                    />
                    Acreditaciones
                  </dt>
                  <dd class="text-muted-foreground mt-1 space-y-0.5">
                    {socio.data.acreditaciones.map((item) => (
                      <p>{item}</p>
                    ))}
                  </dd>
                </div>
              </dl>

              <ul class="mt-5 flex flex-wrap gap-2">
                {socio.data.especialidades.map((especialidad) => (
                  <li class="bg-accent/10 text-accent border-accent/20 rounded-full border px-3 py-1 text-xs font-medium">
                    {especialidad}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
