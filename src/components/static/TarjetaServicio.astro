---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { construirEnlaceWhatsApp } from '../../lib/whatsapp';

interface Props {
	servicio: CollectionEntry<'servicios'>;
}

const { servicio } = Astro.props;
const { titulo, resumen, icono, rangoHonorarios, mensajeWhatsapp, destacado } = servicio.data;
const enlaceWhatsApp = construirEnlaceWhatsApp(mensajeWhatsapp);
---

<article
	class:list={[
		'flex flex-col rounded-2xl border p-6 transition-colors',
		destacado ? 'border-amber-200 bg-amber-50/40' : 'border-slate-200 bg-white',
	]}
>
	<div
		class:list={[
			'flex h-11 w-11 items-center justify-center rounded-full',
			destacado ? 'bg-amber-800 text-white' : 'bg-slate-100 text-slate-700',
		]}
	>
		<Icon name={`lucide:${icono}`} class="h-5 w-5" aria-hidden="true" />
	</div>

	<h3 class="mt-4 font-serif text-lg font-semibold text-slate-900">{titulo}</h3>
	<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{resumen}</p>
	<p class="mt-4 text-sm font-medium text-slate-500">{rangoHonorarios}</p>

	<a
		href={enlaceWhatsApp}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={`Consultar por ${titulo} vía WhatsApp`}
		class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 transition-colors hover:text-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"
	>
		<Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
		Consultar por WhatsApp
	</a>
</article>
