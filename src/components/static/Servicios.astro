---
import { getCollection } from 'astro:content';
import TarjetaServicio from './TarjetaServicio.astro';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
---

<section id="servicios" class="border-border bg-muted/70 scroll-mt-20 border-y">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:px-10 lg:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-anim="linea">Áreas de práctica</p>
        <h2
          data-anim="titulo"
          class="text-foreground mt-5 font-serif text-4xl leading-[1.1] font-medium tracking-tight text-balance sm:text-5xl"
        >
          Servicios jurídicos
        </h2>
      </div>
      <p
        data-anim="subir"
        data-anim-retraso="0.15"
        class="text-muted-foreground text-base leading-relaxed sm:text-lg lg:col-span-5"
      >
        Cuéntenos su caso por WhatsApp: le orientaremos sobre el área que corresponde y le
        explicaremos los honorarios antes de empezar.
      </p>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-servicios-grid>
      {servicios.map((servicio, i) => <TarjetaServicio servicio={servicio} indice={i + 1} />)}
    </div>
  </div>
</section>
