---
import { getCollection } from 'astro:content';
import TarjetaServicio from './TarjetaServicio.astro';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
---

<section id="servicios" class="scroll-mt-20 border-b border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-widest text-amber-800 uppercase">
        Áreas de práctica
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold text-balance text-slate-900 sm:text-4xl">
        Servicios y honorarios
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        Cada área incluye una primera consulta a un precio cerrado, para que sepa desde el principio
        con qué está contando.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {servicios.map((servicio) => <TarjetaServicio servicio={servicio} />)}
    </div>
  </div>
</section>
