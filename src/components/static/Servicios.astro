---
import { getCollection } from 'astro:content';
import TarjetaServicio from './TarjetaServicio.astro';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
---

<section id="servicios" class="border-border bg-muted/95 scroll-mt-20 border-b">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl" data-reveal="up">
      <p class="text-accent text-sm font-semibold tracking-widest uppercase">Áreas de práctica</p>
      <h2 class="text-foreground mt-3 font-serif text-3xl font-semibold text-balance sm:text-4xl">
        Servicios y honorarios
      </h2>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
        Cada área incluye una primera consulta a un precio cerrado, para que sepa desde el principio
        con qué está contando.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-grid>
      {servicios.map((servicio) => <TarjetaServicio servicio={servicio} />)}
    </div>
  </div>
</section>
