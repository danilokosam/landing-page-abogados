---
import { Icon } from 'astro-icon/components';
import { negocio } from '@/lib/negocio';
import { construirEnlaceWhatsApp } from '@/lib/whatsapp';

const enlaceWhatsApp = construirEnlaceWhatsApp('Hola, quisiera agendar una consulta.');
---

<section class="border-border bg-muted border-b">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16 lg:px-8 lg:py-28"
  >
    <div>
      <p class="text-accent text-sm font-semibold tracking-widest uppercase">Abogados en Madrid</p>
      <h1
        class="text-foreground mt-4 font-serif text-4xl leading-tight font-semibold text-balance sm:text-5xl"
      >
        Asesoramiento jurídico claro, en el momento en que lo necesita
      </h1>
      <p class="text-muted-foreground mt-6 max-w-xl text-lg leading-relaxed">
        {negocio.descripcionCorta}
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={enlaceWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-whatsapp text-whatsapp-foreground hover:bg-whatsapp/90 focus-visible:outline-whatsapp inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 text-base font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <Icon name="lucide:message-circle" class="h-5 w-5" aria-hidden="true" />
          Agendar una consulta por WhatsApp
        </a>
        <a
          href="#servicios"
          class="border-border text-foreground hover:border-primary hover:bg-card focus-visible:outline-ring inline-flex items-center justify-center gap-2 rounded-full border px-6 py-3.5 text-base font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          Ver áreas de práctica
          <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <dl
      class="border-border grid grid-cols-2 gap-6 border-t pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12"
    >
      <div>
        <dt class="text-foreground font-serif text-3xl font-semibold">2</dt>
        <dd class="text-muted-foreground mt-1 text-sm">
          Socios fundadores, disponibles en cada caso
        </dd>
      </div>
      <div>
        <dt class="text-foreground font-serif text-3xl font-semibold">20+</dt>
        <dd class="text-muted-foreground mt-1 text-sm">Años de experiencia combinada</dd>
      </div>
      <div>
        <dt class="text-foreground font-serif text-3xl font-semibold">6</dt>
        <dd class="text-muted-foreground mt-1 text-sm">Áreas de práctica cubiertas</dd>
      </div>
      <div>
        <dt class="text-foreground font-serif text-3xl font-semibold">24h</dt>
        <dd class="text-muted-foreground mt-1 text-sm">
          Tiempo de respuesta habitual por WhatsApp
        </dd>
      </div>
    </dl>
  </div>
</section>
