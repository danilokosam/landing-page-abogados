---
import { Icon } from 'astro-icon/components';
import MenuMovil from '@/components/interactive/MenuMovil.astro';
import ThemeToggle from '@/components/interactive/ThemeToggle.astro';
import { negocio } from '@/lib/negocio';
import { construirEnlaceWhatsApp } from '@/lib/whatsapp';

const enlaces = [
  { href: '#sobre-nosotros', texto: 'Sobre Nosotros' },
  { href: '#servicios', texto: 'Servicios' },
  { href: '#contacto', texto: 'Contacto' },
];

const enlaceWhatsApp = construirEnlaceWhatsApp(
  'Hola, quisiera más información sobre sus servicios.',
);
---

<header class="site-header bg-background/85 sticky top-0 z-50 backdrop-blur-sm">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8"
  >
    <a href="#" class="text-foreground font-serif text-lg font-semibold tracking-tight sm:text-xl">
      {negocio.nombreDespacho}
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="mr-2 hidden items-center gap-8 md:flex lg:mr-4" aria-label="Navegación principal">
        {
          enlaces.map((enlace) => (
            <a
              href={enlace.href}
              class="text-muted-foreground hover:text-foreground focus-visible:outline-ring text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              {enlace.texto}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />

      <a
        href={enlaceWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-whatsapp text-whatsapp-foreground hover:bg-whatsapp/90 focus-visible:outline-whatsapp ml-1 hidden items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 md:inline-flex"
      >
        <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
        Contactar por WhatsApp
      </a>

      <MenuMovil enlaces={enlaces} />
    </div>
  </div>
</header>
