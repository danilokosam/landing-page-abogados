---
import { Icon } from 'astro-icon/components';
import MenuMovil from '@/components/interactive/MenuMovil.astro';
import ThemeToggle from '@/components/interactive/ThemeToggle.astro';
import Monograma from '@/components/ui/Monograma.astro';
import { negocio } from '@/lib/negocio';
import { construirEnlaceWhatsApp } from '@/lib/whatsapp';

const enlaces = [
  { href: '#sobre-nosotros', texto: 'Sobre Nosotros' },
  { href: '#servicios', texto: 'Servicios' },
  { href: '#contacto', texto: 'Contacto' },
];

const enlaceWhatsApp = construirEnlaceWhatsApp(
  'Hola, quisiera más información sobre sus servicios.',
);
---

<header class="site-header bg-background/80 sticky top-0 z-50 backdrop-blur-md">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8 lg:px-10"
  >
    <a
      href="#"
      aria-label={`${negocio.nombreDespacho} — ir al inicio`}
      class="group text-foreground focus-visible:outline-ring flex min-w-0 items-center gap-3 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 sm:gap-3.5"
    >
      {/* Decorativo: el nombre del despacho ya da nombre al enlace. */}
      <Monograma
        class="h-10 w-10 shrink-0 transition-opacity duration-300 group-hover:opacity-80"
      />
      <span
        class="truncate font-serif text-base leading-snug font-medium tracking-tight sm:text-xl"
      >
        {negocio.nombreDespacho}
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="mr-3 hidden items-center gap-9 md:flex lg:mr-6" aria-label="Navegación principal">
        {
          enlaces.map((enlace) => (
            <a
              href={enlace.href}
              class="text-muted-foreground hover:text-foreground focus-visible:outline-ring after:bg-gold relative py-1 text-[0.8125rem] font-medium tracking-wide transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:transition-transform after:duration-300 hover:after:scale-x-100 focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              {enlace.texto}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />

      <a
        href={enlaceWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-primary text-primary-foreground focus-visible:outline-ring ml-2 hidden items-center gap-2 rounded-full px-5 py-2.5 text-[0.8125rem] font-semibold tracking-wide transition-[opacity,transform] hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98] md:inline-flex"
      >
        <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
        Agendar consulta
      </a>

      <MenuMovil enlaces={enlaces} />
    </div>
  </div>
</header>
