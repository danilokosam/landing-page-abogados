---
import { Icon } from 'astro-icon/components';
import { negocio } from '@/lib/negocio';
import { construirEnlaceWhatsApp } from '@/lib/whatsapp';

const enlaces = [
  { href: '#sobre-nosotros', texto: 'Sobre Nosotros' },
  { href: '#servicios', texto: 'Servicios' },
  { href: '#contacto', texto: 'Contacto' },
];

const enlaceWhatsApp = construirEnlaceWhatsApp(
  'Hola, quisiera más información sobre sus servicios.',
);
---

<header class="border-border bg-background/85 sticky top-0 z-50 border-b backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href="#" class="text-foreground font-serif text-lg font-semibold tracking-tight sm:text-xl">
      {negocio.nombreDespacho}
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            class="text-muted-foreground hover:text-foreground focus-visible:outline-ring text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <a
        href={enlaceWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-whatsapp text-whatsapp-foreground hover:bg-whatsapp/90 focus-visible:outline-whatsapp inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
        Contactar por WhatsApp
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary
        class="text-foreground focus-visible:outline-ring flex cursor-pointer list-none items-center justify-center rounded-md p-2 focus-visible:outline-2 focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú de navegación"
      >
        <Icon name="lucide:menu" class="h-6 w-6 group-open:hidden" aria-hidden="true" />
        <Icon name="lucide:x" class="hidden h-6 w-6 group-open:block" aria-hidden="true" />
      </summary>

      <nav
        class="border-border bg-card absolute top-full right-0 mt-2 w-56 rounded-lg border p-2 shadow-lg"
        aria-label="Navegación principal (móvil)"
      >
        {
          enlaces.map((enlace) => (
            <a
              href={enlace.href}
              class="text-foreground hover:bg-muted block rounded-md px-3 py-2 text-sm font-medium"
            >
              {enlace.texto}
            </a>
          ))
        }
        <a
          href={enlaceWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-whatsapp text-whatsapp-foreground hover:bg-whatsapp/90 mt-1 flex items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
          Contactar por WhatsApp
        </a>
      </nav>
    </details>
  </div>
</header>
