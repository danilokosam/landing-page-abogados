---
/**
 * Monograma del despacho — "D | M" (Duarte & Muñoz).
 *
 * Las letras son los glifos de Playfair Display 500 (la serif de los
 * titulares) convertidos a trazados, así el logotipo es 100 % vectorial y
 * no depende de que la fuente web haya cargado.
 *
 * Composición: doble filete cuadrado (1 px exterior + filete fino interior,
 * como un sello grabado) y una línea vertical que separa ambas iniciales.
 * La retícula es de 40×40 unidades = 40×40 px al tamaño por defecto, con
 * los filetes alineados a medio píxel para que se vean nítidos en 1x y Retina.
 *
 * Color: todo usa `currentColor` sobre los tokens semánticos del tema, que
 * ya cambian solos entre claro y oscuro (variables CSS en global.css):
 *   - letras  → text-foreground (tinta en claro, marfil en oscuro)
 *   - filetes → text-accent     (oro viejo en claro, champán en oscuro)
 *
 * Accesibilidad: si se pasa `titulo`, el SVG se expone como imagen (role="img",
 * aria-label y <title>); si no, es decorativo (aria-hidden), p. ej. cuando va junto al
 * nombre del despacho dentro del mismo enlace.
 */
interface Props {
  titulo?: string;
  class?: string;
}

const { titulo, class: clase } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 40 40"
  width="40"
  height="40"
  fill="none"
  shape-rendering="geometricPrecision"
  class={clase}
  {...titulo
    ? { role: 'img', 'aria-label': titulo }
    : { 'aria-hidden': 'true', focusable: 'false' }}
>
  {titulo && <title>{titulo}</title>}

  <g class="text-accent" stroke="currentColor">
    <rect x="0.5" y="0.5" width="39" height="39" stroke-width="1"></rect>
    <rect x="2.75" y="2.75" width="34.5" height="34.5" stroke-width="0.5" opacity="0.55"></rect>
    <path d="M18.5 11.5v17" stroke-width="0.75" stroke-linecap="square"></path>
  </g>

  <g class="text-foreground" fill="currentColor">
    <path
      d="M9.96 13.75Q13.22 13.75 14.81 15.33Q16.4 16.91 16.4 19.86Q16.4 21.78 15.62 23.22Q14.85 24.66 13.37 25.46Q11.9 26.25 9.8 26.25Q9.53 26.25 9.08 26.23Q8.63 26.21 8.15 26.21Q7.68 26.2 7.29 26.2Q6.62 26.2 5.97 26.21Q5.33 26.21 4.92 26.25L4.92 25.9Q5.52 25.86 5.82 25.76Q6.12 25.65 6.22 25.33Q6.32 25.01 6.32 24.38L6.32 15.62Q6.32 14.97 6.22 14.66Q6.12 14.35 5.82 14.24Q5.51 14.12 4.92 14.1L4.92 13.75Q5.33 13.77 5.97 13.79Q6.62 13.82 7.25 13.8Q7.89 13.79 8.68 13.77Q9.46 13.75 9.96 13.75ZM9.66 14.07Q8.84 14.07 8.6 14.37Q8.35 14.67 8.35 15.59L8.35 24.41Q8.35 25.33 8.61 25.63Q8.86 25.93 9.67 25.93Q11.46 25.93 12.45 25.23Q13.43 24.54 13.84 23.2Q14.25 21.85 14.25 19.93Q14.25 17.95 13.8 16.65Q13.36 15.36 12.37 14.71Q11.37 14.07 9.66 14.07Z"
    ></path>
    <path
      d="M34.92 13.75L34.92 14.1Q34.32 14.12 34.02 14.24Q33.72 14.35 33.62 14.66Q33.52 14.97 33.52 15.62L33.52 24.38Q33.52 25.01 33.62 25.33Q33.72 25.65 34.02 25.76Q34.32 25.86 34.92 25.9L34.92 26.25Q34.48 26.21 33.82 26.21Q33.17 26.2 32.5 26.2Q31.76 26.2 31.1 26.21Q30.45 26.21 30.06 26.25L30.06 25.9Q30.66 25.86 30.97 25.76Q31.28 25.65 31.39 25.33Q31.49 25.01 31.49 24.38L31.49 14.99L27.24 26.32L26.96 26.32L22.4 14.88L22.4 23.92Q22.4 24.66 22.51 25.08Q22.61 25.49 22.97 25.67Q23.32 25.84 24.04 25.9L24.04 26.25Q23.71 26.21 23.19 26.21Q22.67 26.2 22.21 26.2Q21.77 26.2 21.32 26.21Q20.88 26.21 20.6 26.25L20.6 25.9Q21.18 25.84 21.48 25.68Q21.78 25.51 21.89 25.1Q21.99 24.7 21.99 23.99L21.99 15.62Q21.99 14.97 21.89 14.66Q21.78 14.35 21.48 14.24Q21.18 14.12 20.6 14.1L20.6 13.75Q20.88 13.77 21.32 13.79Q21.77 13.8 22.21 13.8Q22.72 13.8 23.24 13.79Q23.76 13.77 24.13 13.75L27.91 23.46L31.53 13.8L32.5 13.8Q33.17 13.8 33.82 13.79Q34.48 13.77 34.92 13.75Z"
