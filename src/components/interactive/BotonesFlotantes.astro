---
/**
 * Botones flotantes (esquina inferior derecha): "volver arriba" apilado
 * sobre el acceso directo a WhatsApp.
 *
 * Debe montarse en el slot "fixed" de BaseLayout (fuera de #smooth-content):
 * ScrollSmoother transforma ese contenedor y un ancestro transformado rompe
 * `position: fixed` en sus descendientes.
 *
 * Capas: z-30 → por debajo del Header (z-50), del menú móvil a pantalla
 * completa (z-40) y de la intro (z-100), que deben taparlos.
 *
 * Color: tokens semánticos del tema, sin colores fijos. Igual que en el
 * resto de CTAs, WhatsApp NO usa su verde de marca: el icono basta para
 * reconocer el canal (ver --whatsapp en global.css).
 *   - WhatsApp: bg-primary / text-primary-foreground (navy sobre marfil en
 *     claro; champán con tinta en oscuro) + filete oro.
 *   - Volver arriba: bg-card / text-foreground con borde del tema.
 */
import { Icon } from 'astro-icon/components';
import { negocio } from '@/lib/negocio';
import { construirEnlaceWhatsApp, mensajeWhatsappFlotante } from '@/lib/whatsapp';

const enlaceWhatsApp = construirEnlaceWhatsApp(mensajeWhatsappFlotante);

// Área táctil: 48 px en móvil (≥ 44 px recomendados), 56 px desde sm.
const base =
  'focus-visible:outline-ring grid place-items-center rounded-full shadow-lg shadow-black/10 transition-[background-color,border-color,color,opacity,transform,visibility] duration-300 ease-out focus-visible:outline-2 focus-visible:outline-offset-4 active:scale-95 dark:shadow-black/40';
---

<div
  id="botones-flotantes"
  class="pointer-events-none fixed right-[max(1rem,env(safe-area-inset-right))] bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 flex flex-col items-center gap-3 sm:right-6 sm:bottom-6 lg:right-8 lg:bottom-8"
>
  <button
    type="button"
    id="volver-arriba"
    aria-label="Volver al inicio de la página"
    data-visible="false"
    class:list={[
      base,
      'border-border bg-card/90 text-foreground hover:border-gold hover:text-accent h-11 w-11 border backdrop-blur-sm sm:h-12 sm:w-12',
      // Oculto (y fuera del orden de tabulación) mientras se está arriba.
      'invisible translate-y-2 opacity-0 data-[visible=true]:pointer-events-auto data-[visible=true]:visible data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100',
    ]}
  >
    <Icon name="lucide:arrow-up" class="h-5 w-5" aria-hidden="true" />
  </button>

  <a
    href={enlaceWhatsApp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Escribir a ${negocio.nombreDespacho} por WhatsApp (se abre en una pestaña nueva)`}
    class:list={[
      base,
      'bg-primary text-primary-foreground ring-gold/60 ring-offset-background pointer-events-auto h-12 w-12 ring-1 ring-offset-2 hover:-translate-y-0.5 hover:opacity-90 sm:h-14 sm:w-14',
    ]}
  >
    {/* Glifo oficial de WhatsApp (Simple Icons, CC0). */}
    <svg
      viewBox="0 0 24 24"
      class="h-6 w-6 sm:h-7 sm:w-7"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
      ></path>
    </svg>
  </a>
</div>

<script>
  // Script de módulo (ver la nota de MenuMovil.astro): el import del
  // frontmatter no es visible aquí.
  import { ScrollSmoother } from '@/lib/gsap/setup';

  const boton = document.getElementById('volver-arriba');

  if (boton) {
    // Aparece tras bajar algo más de media pantalla (pasado el Hero).
    const umbral = () => window.innerHeight * 0.6;
    let pendiente = false;

    const actualizar = () => {
      pendiente = false;
      boton.dataset.visible = String(window.scrollY > umbral());
    };

    // ScrollSmoother conserva el scroll nativo de la ventana (solo suaviza
    // el pintado), así que window.scrollY es fiable con o sin él.
    window.addEventListener(
      'scroll',
      () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(actualizar);
      },
      { passive: true },
    );
    actualizar();

    boton.addEventListener('click', () => {
      // Con ScrollSmoother activo hay que delegar en su scrollTo para que
      // ScrollTrigger siga sincronizado (mismo motivo que en los enlaces
      // de anclaje, ver scrollSmoother.ts). Sin él (táctil o movimiento
      // reducido), scroll nativo; instantáneo si se pidió reducir movimiento.
      const smoother = ScrollSmoother.get();
      if (smoother) {
        smoother.scrollTo(0, true);
      } else {
        const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reducir ? 'auto' : 'smooth' });
      }

      // El botón se oculta al llegar arriba: se lleva el foco al enlace de
      // inicio del Header para que el teclado no lo pierda.
      document
        .querySelector<HTMLElement>('header.site-header a[href="#"]')
        ?.focus({ preventScroll: true });
    });
  }
</script>
