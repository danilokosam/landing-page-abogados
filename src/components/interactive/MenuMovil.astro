---
/**
 * Menú móvil a pantalla completa. Usa <details>/<summary> nativo como
 * mecanismo de apertura/cierre (en vez de estado en JS) para heredar
 * gratis su comportamiento: no se cierra al hacer clic en zonas vacías
 * internas (los navegadores solo lo cierran al activar el <summary> o
 * vía JS/teclado — nunca por un clic "fuera"), y expone su estado de
 * forma razonable a lectores de pantalla. El <script> de abajo solo
 * añade lo que <details> no da de fábrica: bloqueo de scroll del body,
 * cierre automático al pulsar un enlace y cierre con Escape.
 *
 * El panel usa `h-dvh` en vez de `inset-0`/`bottom-0` a propósito: el
 * <header> padre tiene `backdrop-blur-sm` (backdrop-filter), y
 * cualquier ancestro con filter/backdrop-filter crea un nuevo contexto
 * de contención para descendientes `position:fixed` — un `inset-0`
 * ahí se calcula contra la caja (pequeña) del header, no contra el
 * viewport real, y el panel queda con solo unos 100px de alto en vez
 * de pantalla completa. `top-0` + `h-dvh` evita el problema porque las
 * unidades de viewport (dvh) siempre se resuelven contra el viewport
 * real, sin importar el contexto de contención — y como el header es
 * sticky en top:0, su borde superior siempre coincide con el del
 * viewport, así que top:0 relativo al header sigue siendo correcto.
 */
import { Icon } from 'astro-icon/components';
import { construirEnlaceWhatsApp } from '@/lib/whatsapp';

// Nota de implementación (bloqueo de scroll, revisitada): un intento
// anterior de usar `ScrollSmoother.get()?.paused()` se descartó porque
// parecía reiniciar window.scrollY a 0. Investigando el propio código
// fuente de gsap/ScrollSmoother.js: paused(true) NO toca el layout en
// absoluto — internamente usa ScrollTrigger.observe({preventDefault:true,
// type:'wheel,touch,scroll', onChangeY: () => scrollTop(-currentY)}) para
// rechazar el input de scroll, preservando currentY intacto; paused(false)
// simplemente recalcula el progreso a partir de ese mismo currentY. El
// reinicio a 0 que se observó no venía de paused() en sí, sino de
// combinarlo con el bloqueo manual de abajo (position:fixed en <body>) al
// mismo tiempo: ScrollSmoother fija la altura de <body> en su propio
// refreshHeight() para poder scrollear de forma nativa — poner ese mismo
// <body> en position:fixed lo saca del flujo normal, colapsa la altura
// scrolleable real de <html> a la del viewport mientras el menú está
// abierto, y desincroniza la posición interna de ScrollSmoother respecto
// al scroll real (el bug reportado: la siguiente animación arranca desde
// 0). La solución correcta es no mezclar ambos mecanismos: cuando hay un
// ScrollSmoother activo se usa su propio paused() (no toca <body> en
// absoluto); solo se recurre al patrón manual de position:fixed cuando NO
// hay ScrollSmoother (táctil o prefers-reduced-motion — ver
// esDispositivoTactil() en scrollSmoother.ts), caso en el que no hay
// ningún estado de ScrollSmoother que preservar.

interface Enlace {
  href: string;
  texto: string;
}

interface Props {
  enlaces: Enlace[];
}

const { enlaces } = Astro.props;
const enlaceWhatsApp = construirEnlaceWhatsApp(
  'Hola, quisiera más información sobre sus servicios.',
);
---

<details id="menu-movil" class="group lg:hidden">
  <summary
    id="menu-movil-boton"
    class="text-foreground hover:bg-muted focus-visible:outline-ring relative z-50 flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden"
    aria-label="Abrir menú de navegación"
  >
    <Icon name="lucide:menu" class="h-5 w-5 group-open:hidden" aria-hidden="true" />
    <Icon name="lucide:x" class="hidden h-5 w-5 group-open:block" aria-hidden="true" />
  </summary>

  <nav
    class="bg-background fixed inset-x-0 top-0 z-40 flex h-dvh flex-col px-6 pt-24 pb-10"
    aria-label="Navegación principal (móvil)"
  >
    <ul class="flex flex-col">
      {
        enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              data-menu-movil-enlace
              class="text-foreground hover:text-accent border-border block border-b py-5 font-serif text-3xl font-medium transition-colors"
            >
              {enlace.texto}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={enlaceWhatsApp}
      target="_blank"
      rel="noopener noreferrer"
      data-menu-movil-enlace
      class="bg-primary text-primary-foreground mt-auto flex items-center justify-center gap-2 rounded-full px-6 py-4 text-base font-semibold tracking-wide transition-opacity hover:opacity-90"
    >
      <Icon name="lucide:message-circle" class="h-5 w-5" aria-hidden="true" />
      Agendar consulta por WhatsApp
    </a>
  </nav>
</details>

<script>
  // Import dentro del propio <script>, no en el frontmatter: Astro compila
  // el frontmatter y los <script> del cliente como módulos completamente
  // separados — un import de frontmatter no es visible aquí.
  import { ScrollSmoother } from '@/lib/gsap/setup';

  const detalles = document.getElementById('menu-movil');
  const boton = document.getElementById('menu-movil-boton');

  if (detalles instanceof HTMLDetailsElement && boton) {
    let scrollGuardado = 0;
    let bloqueado = false;
    // Referencia capturada en bloquearScroll() y reutilizada tal cual en
    // restaurarScroll(), en vez de volver a llamar a ScrollSmoother.get()
    // en ese momento: así ambas mitades del bloqueo quedan consistentes
    // aunque el estado global de ScrollSmoother cambiase mientras el menú
    // está abierto (p. ej. el usuario alterna prefers-reduced-motion en el
    // sistema operativo a media navegación).
    let smootherBloqueado: ScrollSmoother | null = null;

    // Ambas funciones son idempotentes (protegidas por `bloqueado`) porque
    // restaurarScroll() se llama desde dos sitios distintos — ver más abajo
    // por qué.
    function bloquearScroll(): void {
      if (bloqueado) return;
      bloqueado = true;

      smootherBloqueado = ScrollSmoother.get() ?? null;
      if (smootherBloqueado) {
        // ScrollSmoother activo: su propio paused(true) es lo correcto
        // aquí — congela el scroll sin tocar el layout de <body> en
        // absoluto (ver nota de implementación arriba), así que su
        // posición interna nunca se desincroniza del scroll real.
        smootherBloqueado.paused(true);
        return;
      }

      // Sin ScrollSmoother (táctil o prefers-reduced-motion): patrón
      // robusto a prueba de iOS Safari, que ignora overflow:hidden en el
      // body mientras el usuario arrastra — fija el body en su posición
      // actual con position:fixed y lo restaura al cerrar, sin perder el
      // punto de scroll original.
      scrollGuardado = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollGuardado}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
    }

    function restaurarScroll(): void {
      if (!bloqueado) return;
      bloqueado = false;

      if (smootherBloqueado) {
        smootherBloqueado.paused(false);
        smootherBloqueado = null;
        return;
      }

      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      // behavior:'instant' explícito a propósito: la forma de dos
      // argumentos de scrollTo() usa behavior:'auto', que hereda
      // `scroll-behavior: smooth` de <html> (global.css) y animaría esta
      // restauración, compitiendo por el scroll con la navegación nativa
      // que arranca justo después.
      window.scrollTo({ top: scrollGuardado, left: 0, behavior: 'instant' });
    }

    // Reacciona al estado real de <details> para abrir/cerrar el
    // bloqueo en el caso general (botón, Escape). OJO: el evento
    // "toggle" se despacha como una tarea diferida según el estándar
    // HTML — incluso al cambiar `.open` por script, no llega en el
    // mismo tick. Eso es intrascendente para abrir (nada compite por
    // el scroll en ese instante), pero SÍ importa al cerrar por un
    // enlace — ver el listener de abajo.
    detalles.addEventListener('toggle', () => {
      if (detalles.open) {
        bloquearScroll();
        boton.setAttribute('aria-label', 'Cerrar menú de navegación');
      } else {
        restaurarScroll();
        boton.setAttribute('aria-label', 'Abrir menú de navegación');
      }
    });

    // Cierre automático al navegar. El salto/scroll hacia la sección lo
    // dispara, por separado, el listener de clics de scrollSmoother.ts
    // (delegado en document) — ese listener corre DESPUÉS de este en la
    // fase de burbuja del mismo clic, así que aquí ya podemos desbloquear
    // el scroll de forma síncrona antes de que le toque el turno.
    //
    // Es necesario llamar a restaurarScroll() aquí mismo, no solo
    // dejarlo a cargo del evento "toggle": al ser una tarea diferida,
    // para cuando ese evento llega scrollSmoother ya intentó animar el
    // scroll con el body todavía en position:fixed (bloqueado) — la URL
    // cambiaba de hash pero la página nunca se movía visualmente. La
    // llamada de aquí es síncrona y gana esa carrera; la que llegue
    // después vía "toggle" queda protegida por el guard de `bloqueado`
    // y no hace nada (evita un doble scrollTo que pelee con la
    // animación de scrollSmoother ya en marcha).
    detalles.querySelectorAll('[data-menu-movil-enlace]').forEach((enlace) => {
      enlace.addEventListener('click', () => {
        detalles.open = false;
        restaurarScroll();
      });
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && detalles.open) {
        detalles.open = false;
      }
    });
  }
</script>
